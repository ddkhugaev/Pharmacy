<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - МАРТ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="nav">
        <div class="nav-logo">
            <svg class="nav-logo-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="12" y="2" width="12" height="32" rx="3" fill="#8DC86B" />
                <rect x="2" y="12" width="32" height="12" rx="3" fill="#7EC8E3" />
                <ellipse cx="15" cy="20" rx="6" ry="8" fill="#5BA544" />
                <ellipse cx="21" cy="18" rx="4" ry="6" fill="#5BA544" opacity="0.7" />
            </svg>
            <a class="nav-logo-text" asp-controller="Home" asp-action="Index">МАРТ</a>
        </div>
        <div class="nav-links">
            <a asp-controller="Medicines" asp-action="Index">Каталог</a>
            <a href="#">Акции</a>
            <a href="#">Доставка</a>
            <a href="#">О нас</a>
        </div>
        <div class="nav-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <i class="ti ti-heart" aria-hidden="true"></i>
                <i class="ti ti-shopping-cart" aria-hidden="true"></i>
                <a class="nav-user" asp-controller="Profile" asp-action="Index">
                    <i class="ti ti-user-circle" aria-hidden="true"></i>
                    @User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-outline">Выйти</button>
                </form>
            }
            else
            {
                <i class="ti ti-heart" aria-hidden="true"></i>
                <i class="ti ti-shopping-cart" aria-hidden="true"></i>
                <a class="btn-outline" asp-controller="Account" asp-action="Login">Войти</a>
                <a class="btn-primary" asp-controller="Account" asp-action="Register">Регистрация</a>
            }
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-logo">
                <svg class="nav-logo-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="12" y="2" width="12" height="32" rx="3" fill="#8DC86B" />
                    <rect x="2" y="12" width="32" height="12" rx="3" fill="#7EC8E3" />
                    <ellipse cx="15" cy="20" rx="6" ry="8" fill="#5BA544" />
                    <ellipse cx="21" cy="18" rx="4" ry="6" fill="#5BA544" opacity="0.7" />
                </svg>
                <span class="nav-logo-text">МАРТ</span>
            </div>
            <div class="footer-copy">&copy; 2026 Аптека МАРТ. Все права защищены.</div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
