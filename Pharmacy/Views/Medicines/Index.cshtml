@model CatalogViewModel
@{
    ViewData["Title"] = "Каталог";
}

<div class="catalog-layout">

    <!-- Боковая панель с фильтрами -->
    <aside class="catalog-sidebar">
        <form method="get" asp-action="Index">
            <div class="sidebar-section">
                <div class="sidebar-title">Поиск</div>
                <div class="sidebar-search">
                    <i class="ti ti-search" aria-hidden="true"></i>
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" placeholder="Название препарата..." />
                </div>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-title">Категория</div>
                <div class="sidebar-options">
                    @foreach (var category in Model.Categories)
                    {
                        <label class="sidebar-option">
                            <input type="checkbox"
                                   name="selectedCategories"
                                   value="@category.Id"
                                   @(Model.SelectedCategories.Contains(category.Id) ? "checked" : "") />
                            @category.Name
                        </label>
                    }
                </div>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-title">Цена</div>
                <div class="price-range">
                    <input type="number" name="priceFrom" class="price-input"
                           value="@Model.PriceFrom" placeholder="От" />
                    <span>-</span>
                    <input type="number" name="priceTo" class="price-input"
                           value="@Model.PriceTo" placeholder="До" />
                </div>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-title">Рецепт</div>
                <div class="sidebar-options">
                    <label class="sidebar-option">
                        <input type="radio" name="prescriptionRequired" value=""
                               @(Model.PrescriptionRequired == null ? "checked" : "") />
                        Все
                    </label>
                    <label class="sidebar-option">
                        <input type="radio" name="prescriptionRequired" value="false"
                               @(Model.PrescriptionRequired == false ? "checked" : "") />
                        Без рецепта
                    </label>
                    <label class="sidebar-option">
                        <input type="radio" name="prescriptionRequired" value="true"
                               @(Model.PrescriptionRequired == true ? "checked" : "") />
                        По рецепту
                    </label>
                </div>
            </div>

            <input type="hidden" name="sortBy" value="@Model.SortBy" />

            <button type="submit" class="btn-green sidebar-apply">Применить</button>
            <a class="btn-ghost sidebar-reset" asp-action="Index">Сбросить</a>
        </form>
    </aside>

    <!-- Основной контент -->
    <div class="catalog-main">

        <!-- Шапка каталога -->
        <div class="catalog-header">
            <div class="catalog-info">
                <div class="section-title">Каталог лекарств</div>
                <div class="section-sub">Найдено @Model.TotalCount препаратов</div>
            </div>
            <div class="catalog-sort">
                <span class="sort-label">Сортировка:</span>
                <select class="sort-select" onchange="applySort(this.value)">
                    <option value="popular" selected="@(Model.SortBy == "popular")">По популярности</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">По цене - дешевле</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">По цене - дороже</option>
                    <option value="rating" selected="@(Model.SortBy == "rating")">По рейтингу</option>
                    <option value="name" selected="@(Model.SortBy == "name")">По названию</option>
                </select>
            </div>
        </div>

        <!-- Сетка товаров -->
        @if (Model.Medicines.Any())
        {
            <div class="catalog-grid">
                @foreach (var medicine in Model.Medicines)
                {
                    <div class="prod-card">
                        <div class="prod-img">💊</div>
                        @if (medicine.CategoryName != null)
                        {
                            <div class="prod-cat">@medicine.CategoryName</div>
                        }
                        <div class="prod-name">@medicine.Name</div>
                        @if (medicine.PrescriptionRequired)
                        {
                            <div class="rx-badge">По рецепту</div>
                        }
                        <div class="prod-footer">
                            <div class="prod-price">@medicine.Price.ToString("N0") ₽</div>
                            <button class="prod-btn"><i class="ti ti-plus" aria-hidden="true"></i></button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="catalog-empty">
                <i class="ti ti-search-off" aria-hidden="true"></i>
                <div class="catalog-empty-title">Ничего не найдено</div>
                <div class="catalog-empty-sub">Попробуйте изменить параметры поиска</div>
            </div>
        }

        <!-- Пагинация -->
        @if (Model.TotalPages > 1)
        {
            <div class="pagination">
                @if (Model.CurrentPage > 1)
                {
                    <a class="page-btn" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-priceFrom="@Model.PriceFrom"
                       asp-route-priceTo="@Model.PriceTo"
                       asp-route-prescriptionRequired="@Model.PrescriptionRequired"
                       asp-route-sortBy="@Model.SortBy">
                        <i class="ti ti-chevron-left" aria-hidden="true"></i>
                    </a>
                }
                else
                {
                    <button class="page-btn" disabled>
                        <i class="ti ti-chevron-left" aria-hidden="true"></i>
                    </button>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == 1 || i == Model.TotalPages || (i >= Model.CurrentPage - 1 && i <= Model.CurrentPage + 1))
                    {
                        <a class="page-btn @(i == Model.CurrentPage ? "active" : "")"
                           asp-action="Index" asp-route-page="@i"
                           asp-route-searchQuery="@Model.SearchQuery"
                           asp-route-priceFrom="@Model.PriceFrom"
                           asp-route-priceTo="@Model.PriceTo"
                           asp-route-prescriptionRequired="@Model.PrescriptionRequired"
                           asp-route-sortBy="@Model.SortBy">@i</a>
                    }
                    else if (i == Model.CurrentPage - 2 || i == Model.CurrentPage + 2)
                    {
                        <span class="page-dots">...</span>
                    }
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a class="page-btn" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-priceFrom="@Model.PriceFrom"
                       asp-route-priceTo="@Model.PriceTo"
                       asp-route-prescriptionRequired="@Model.PrescriptionRequired"
                       asp-route-sortBy="@Model.SortBy">
                        <i class="ti ti-chevron-right" aria-hidden="true"></i>
                    </a>
                }
                else
                {
                    <button class="page-btn" disabled>
                        <i class="ti ti-chevron-right" aria-hidden="true"></i>
                    </button>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function applySort(value) {
            const url = new URL(window.location.href);
            url.searchParams.set('sortBy', value);
            url.searchParams.set('page', '1');
            window.location.href = url.toString();
        }
    </script>
}
