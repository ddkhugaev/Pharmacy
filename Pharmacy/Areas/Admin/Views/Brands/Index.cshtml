@model List<Pharmacy.Areas.Admin.Models.BrandViewModel>
@{
    ViewData["Title"] = "Бренды";
    Layout = "_AdminLayout";
}

<div class="admin-header">
    <h1 class="admin-title">Бренды</h1>
    <a asp-action="Create" class="btn-green">+ Добавить</a>
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var brand in Model)
            {
                <tr>
                    <td>@brand.Id</td>
                    <td>@brand.Name</td>
                    <td class="admin-actions">
                        <a asp-action="Edit" asp-route-id="@brand.Id" class="btn-admin-edit">Изменить</a>
                        <a asp-action="Delete" asp-route-id="@brand.Id" class="btn-admin-delete">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
